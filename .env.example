# Copiar a .env y completar con valores reales. Nunca commitear .env.
# Ninguno de los valores de este archivo es real (CLAUDE.md — Límites y claridad).

# --- Sanity (CMS de contenido editorial) ---
# Read-only, expuestas al bundle público (build estático). El token de
# escritura del Studio NUNCA va aquí ni en ninguna variable PUBLIC_*.
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production
# Token de escritura, solo server-side (webhooks de revalidación, scripts de
# seed). Nunca prefijar con PUBLIC_.
SANITY_WRITE_TOKEN=

# --- Neon (Postgres serverless — tabla `leads`) ---
DATABASE_URL=

# --- Resend (email transaccional, RF-002) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Upstash Redis (rate limiting, RF-001) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Cloudflare Turnstile (anti-bot, RF-001) ---
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Analítica de campaña (Build 4 — cuentas de test, nunca de cliente real) ---
PUBLIC_GTM_CONTAINER_ID=

# --- CSP ---
# El nonce se genera por request en middleware server-side; no es una env var.
