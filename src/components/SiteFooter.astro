---
import { buildWhatsAppUrl, type FooterContent } from '../lib/domain/content';

interface Props {
  content: FooterContent | null;
  utm: { source?: string | null; medium?: string | null; campaign?: string | null };
  productName: string;
}

const { content, utm, productName } = Astro.props;
const whatsappUrl = content?.whatsappNumber
  ? buildWhatsAppUrl(
      content.whatsappNumber,
      content.whatsappMessage ?? 'Hola, quiero más info sobre KOA Buds',
      utm,
    )
  : null;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-top">
      <div class="footer-brand">
        <a href="#top" class="brand">
          <span class="brand-mark" aria-hidden="true"></span>
          <span>{productName}</span>
        </a>
        <p class="footer-tagline">Audio true wireless con cancelación de ruido activa. Preventa abierta.</p>
      </div>

      <div class="footer-actions">
        {
          whatsappUrl && (
            <a class="btn btn-ghost footer-wa" href={whatsappUrl} target="_blank" rel="noopener noreferrer">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
                <path d="M12 2a10 10 0 0 0-8.6 15l-1.3 4.7 4.8-1.3A10 10 0 1 0 12 2Zm5.3 14c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .2-3.3-.7-2.8-1.1-4.5-3.9-4.7-4.1-.1-.2-1-1.4-1-2.6s.6-1.8.9-2.1c.2-.2.5-.3.6-.3h.5c.2 0 .4 0 .6.5l.8 1.9c.1.2.1.4 0 .5l-.4.5c-.2.2-.3.4-.1.7.2.3.9 1.4 1.9 2.3 1.3 1.1 2.3 1.5 2.6 1.6.2.1.4.1.6-.1l.7-.9c.2-.2.4-.2.6-.1l1.8.9c.3.1.5.2.5.3.1.2.1.9-.1 1.6Z" />
              </svg>
              Escríbenos por WhatsApp
            </a>
          )
        }
        {
          content?.socialLinks && content.socialLinks.length > 0 && (
            <nav class="footer-social" aria-label="Redes sociales">
              {content.socialLinks.map((link) => (
                <a href={link.url} target="_blank" rel="noopener noreferrer">
                  {link.platform}
                </a>
              ))}
            </nav>
          )
        }
        <nav class="footer-nav" aria-label="Secciones">
          <a href="#specs">Specs</a>
          <a href="#galeria">Galería</a>
          <a href="#faq">FAQ</a>
          <a href="#waitlist">Lista de espera</a>
        </nav>
      </div>
    </div>

    <div class="footer-bottom">
      <p>© {year} {productName} — caso de estudio de demo, producto ficticio.</p>
      <p class="footer-legal">Datos tratados según la Ley 1581 de 2012 (Habeas Data, Colombia).</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    padding-block: clamp(3rem, 7vw, 5rem) 2.5rem;
    background: linear-gradient(180deg, transparent, rgba(255, 45, 146, 0.04));
  }
  .footer-top {
    display: grid;
    gap: 2.5rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--border);
  }
  .footer-brand .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.2rem;
  }
  .brand-mark {
    width: 26px;
    height: 26px;
    border-radius: 9px;
    background: var(--grad-brand);
    box-shadow: var(--glow-magenta);
    position: relative;
  }
  .brand-mark::after {
    content: '';
    position: absolute;
    inset: 7px;
    border-radius: 4px;
    background: var(--bg);
  }
  .footer-tagline {
    color: var(--text-muted);
    font-size: 0.92rem;
    margin-top: 0.9rem;
    max-width: 34ch;
  }
  .footer-actions {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    align-items: flex-start;
  }
  .footer-wa {
    padding: 0.7rem 1.25rem;
  }
  .footer-nav,
  .footer-social {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.5rem;
    color: var(--text-dim);
    font-size: 0.92rem;
  }
  .footer-nav a:hover,
  .footer-social a:hover {
    color: var(--text);
  }
  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding-top: 1.75rem;
    color: var(--text-muted);
    font-size: 0.82rem;
  }
  .footer-legal {
    opacity: 0.85;
  }
  @media (min-width: 760px) {
    .footer-top {
      grid-template-columns: 1fr auto;
      align-items: start;
    }
    .footer-actions {
      align-items: flex-end;
    }
  }
</style>
