---
import { urlForImage } from '../lib/adapters/sanity';
import type { GalleryContent } from '../lib/domain/content';

interface Props {
  content: GalleryContent | null;
}
const { content } = Astro.props;
---

{
  content && content.images.length > 0 && (
    <section class="section gallery-cms">
      <div class="container">
        <span class="eyebrow" data-reveal>
          Galería
        </span>
        <div class="gallery-grid">
          {content.images.map((image, i) => (
            <figure class="g-item" data-reveal data-reveal-delay={String((i % 3) + 1)}>
              <img
                src={urlForImage(image).width(800).height(600).fit('crop').url()}
                alt={`KOA Buds — foto ${i + 1}`}
                loading="lazy"
                width="800"
                height="600"
              />
            </figure>
          ))}
        </div>
      </div>
    </section>
  )
}

<style>
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: 1rem;
    margin-top: 1.5rem;
  }
  .g-item {
    margin: 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--border);
  }
  .g-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s var(--ease);
  }
  .g-item:hover img {
    transform: scale(1.05);
  }
</style>
