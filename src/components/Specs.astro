---
import type { SpecsSectionContent } from '../lib/domain/content';

interface Props {
  content: SpecsSectionContent | null;
}

const { content } = Astro.props;
---

{
  content && (
    <section class="specs">
      <h2>{content.heading}</h2>
      <dl>
        {content.items.map((item) => (
          <div>
            <dt>{item.label}</dt>
            <dd>{item.value}</dd>
          </div>
        ))}
      </dl>
    </section>
  )
}

<style>
  .specs {
    max-width: 40rem;
    margin: 0 auto;
    padding: 2rem 1.5rem;
  }
  h2 {
    text-align: center;
    margin: 0 0 1.5rem;
  }
  dl {
    display: grid;
    gap: 1rem;
  }
  dl > div {
    display: flex;
    justify-content: space-between;
    border-bottom: 1px solid rgba(245, 245, 247, 0.15);
    padding-bottom: 0.75rem;
  }
  dt {
    opacity: 0.7;
  }
  dd {
    margin: 0;
    font-weight: 600;
  }
</style>
