---
import { Image } from 'astro:assets';
import detailImg from '../assets/earbuds-detail.jpg';
import handImg from '../assets/earbuds-hand.jpg';
import lineupImg from '../assets/earbuds-lineup.jpg';
---

<section id="galeria" class="section showcase">
  <div class="container">
    <div class="showcase-head">
      <span class="eyebrow" data-reveal>Diseño</span>
      <h2 class="section-title" data-reveal data-reveal-delay="1">
        Pensados hasta el <span class="gradient-text">último detalle</span>
      </h2>
      <p class="lead" data-reveal data-reveal-delay="2">
        Un estuche compacto, un ajuste que desaparece y materiales que se sienten premium desde el primer
        toque.
      </p>
    </div>

    <div class="bento">
      <figure class="tile tile-tall" data-reveal>
        <Image
          src={detailImg}
          alt="Detalle de los audífonos KOA Buds sobre fondo negro"
          widths={[420, 640, 820]}
          sizes="(max-width: 760px) 90vw, 480px"
          loading="lazy"
        />
        <figcaption>Acabado premium · negro estelar</figcaption>
      </figure>

      <figure class="tile" data-reveal data-reveal-delay="1">
        <Image
          src={handImg}
          alt="Estuche de KOA Buds sostenido en la mano"
          widths={[420, 640, 820]}
          sizes="(max-width: 760px) 90vw, 480px"
          loading="lazy"
        />
        <figcaption>Estuche de bolsillo</figcaption>
      </figure>

      <figure class="tile" data-reveal data-reveal-delay="2">
        <Image
          src={lineupImg}
          alt="Distintos formatos de audífonos true wireless"
          widths={[420, 640, 820]}
          sizes="(max-width: 760px) 90vw, 480px"
          loading="lazy"
        />
        <figcaption>Ergonomía true wireless</figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  .showcase-head {
    max-width: 44rem;
    margin-bottom: clamp(2.5rem, 6vw, 4rem);
    display: grid;
    gap: 1rem;
  }
  .bento {
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
  }
  .tile {
    position: relative;
    margin: 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--bg-2);
  }
  .tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease);
  }
  .tile:hover img {
    transform: scale(1.05);
  }
  .tile figcaption {
    position: absolute;
    left: 1rem;
    bottom: 1rem;
    padding: 0.45rem 0.85rem;
    border-radius: var(--pill);
    background: rgba(6, 6, 8, 0.72);
    border: 1px solid var(--border);
    backdrop-filter: blur(10px);
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--text);
  }
  .tile:not(.tile-tall) img {
    aspect-ratio: 16 / 10;
  }
  .tile-tall img {
    aspect-ratio: 4 / 5;
  }

  @media (min-width: 760px) {
    .bento {
      grid-template-columns: 1.05fr 1fr;
      grid-auto-rows: 1fr;
    }
    .tile-tall {
      grid-row: span 2;
    }
    .tile-tall img {
      height: 100%;
      aspect-ratio: auto;
    }
  }
</style>
