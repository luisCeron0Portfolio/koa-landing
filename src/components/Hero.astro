---
import { Image } from 'astro:assets';
import heroImg from '../assets/earbuds-hero.jpg';
import type { HeroContent } from '../lib/domain/content';

interface Props {
  content: HeroContent | null;
}

const { content } = Astro.props;
const productName = content?.productName ?? 'KOA Buds';
const valueProp = content?.valueProposition ?? 'Cancelación de ruido activa que se olvida que existe.';
const ctaLabel = content?.ctaLabel ?? 'Unirme a la lista de espera';

// Resalta la última palabra del nombre con el gradiente de marca.
const parts = productName.trim().split(/\s+/);
const nameHead = parts.length > 1 ? parts.slice(0, -1).join(' ') : '';
const nameTail = parts.at(-1) ?? productName;
---

<section id="top" class="hero">
  <div class="hero-orbs" aria-hidden="true">
    <span class="orb orb-c"></span>
    <span class="orb orb-m"></span>
  </div>

  <div class="container hero-grid">
    <div class="hero-copy">
      <span class="chip hero-in">
        <span class="dot"></span> Preventa abierta · cupos limitados
      </span>

      <h1 class="hero-title hero-in">
        {nameHead && <span>{nameHead} </span>}<span class="gradient-text">{nameTail}</span>
      </h1>

      <p class="lead hero-lead hero-in">{valueProp}</p>

      <div class="hero-actions hero-in">
        <a href="#waitlist" class="btn btn-primary">{ctaLabel}</a>
        <a href="#specs" class="btn btn-ghost">Ver especificaciones</a>
      </div>

      <ul class="hero-trust hero-in">
        <li><strong>ANC</strong> adaptativa</li>
        <li><strong>32 h</strong> de batería</li>
        <li><strong>IPX4</strong> resistente</li>
        <li><strong>BT 5.3</strong> estable</li>
      </ul>
    </div>

    <div class="hero-visual">
      <div class="visual-ring" aria-hidden="true"></div>
      <Image
        class="hero-img"
        src={heroImg}
        alt={`${productName} — audífonos true wireless con iluminación neón`}
        widths={[380, 560, 760]}
        sizes="(max-width: 900px) 74vw, 440px"
        loading="eager"
        fetchpriority="high"
      />
      <span class="float-pill pill-1" aria-hidden="true">Cancelación activa</span>
      <span class="float-pill pill-2" aria-hidden="true">32 h · estuche</span>
    </div>
  </div>

  <a href="#por-que" class="scroll-cue" aria-label="Desplazarse hacia abajo">
    <span></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-height: min(100svh, 900px);
    display: flex;
    align-items: center;
    padding-block: 3rem 5rem;
    overflow: hidden;
  }
  .hero-orbs {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  .orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(70px);
    opacity: 0.55;
  }
  .orb-c {
    width: 40vw;
    height: 40vw;
    max-width: 520px;
    max-height: 520px;
    left: -8vw;
    top: 6%;
    background: radial-gradient(circle, rgba(46, 230, 207, 0.65), transparent 70%);
    animation: drift-a 16s var(--ease) infinite alternate;
  }
  .orb-m {
    width: 45vw;
    height: 45vw;
    max-width: 560px;
    max-height: 560px;
    right: -10vw;
    bottom: -6%;
    background: radial-gradient(circle, rgba(255, 45, 146, 0.6), transparent 70%);
    animation: drift-b 20s var(--ease) infinite alternate;
  }
  @keyframes drift-a {
    to {
      transform: translate(6%, 8%) scale(1.12);
    }
  }
  @keyframes drift-b {
    to {
      transform: translate(-5%, -7%) scale(1.15);
    }
  }

  .hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    gap: clamp(2.5rem, 6vw, 4rem);
    align-items: center;
  }

  .hero-title {
    font-size: clamp(3rem, 12vw, 6.4rem);
    font-weight: 700;
    margin: 1.4rem 0 1.2rem;
  }
  .hero-lead {
    font-size: clamp(1.1rem, 2.5vw, 1.4rem);
    max-width: 34ch;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 2rem;
  }
  .hero-trust {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
    padding: 0;
    margin: 2.5rem 0 0;
    color: var(--text-muted);
    font-size: 0.92rem;
  }
  .hero-trust strong {
    color: var(--text);
    font-family: var(--font-display);
  }

  /* visual */
  .hero-visual {
    position: relative;
    justify-self: center;
    width: min(88vw, 440px);
    aspect-ratio: 3 / 4;
  }
  .visual-ring {
    position: absolute;
    inset: -6%;
    border-radius: 40px;
    background: conic-gradient(
      from 140deg,
      rgba(46, 230, 207, 0.35),
      rgba(255, 45, 146, 0.35),
      rgba(46, 230, 207, 0.35)
    );
    filter: blur(28px);
    opacity: 0.85;
    animation: spin 22s linear infinite;
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
  .hero-img {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 30px;
    border: 1px solid var(--border-strong);
    box-shadow: var(--shadow-soft);
  }
  .float-pill {
    position: absolute;
    z-index: 2;
    padding: 0.55rem 0.95rem;
    border-radius: var(--pill);
    background: rgba(10, 10, 16, 0.72);
    border: 1px solid var(--border-strong);
    backdrop-filter: blur(12px);
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--text);
    white-space: nowrap;
    box-shadow: var(--shadow-soft);
  }
  .pill-1 {
    top: 12%;
    left: -8%;
    animation: bob 6s var(--ease) infinite alternate;
  }
  .pill-2 {
    bottom: 14%;
    right: -6%;
    animation: bob 7s var(--ease) infinite alternate-reverse;
  }
  @keyframes bob {
    to {
      transform: translateY(-10px);
    }
  }

  .scroll-cue {
    position: absolute;
    left: 50%;
    bottom: 1.5rem;
    transform: translateX(-50%);
    width: 26px;
    height: 42px;
    border: 1px solid var(--border-strong);
    border-radius: var(--pill);
    display: grid;
    place-items: start center;
    padding-top: 8px;
    z-index: 1;
  }
  .scroll-cue span {
    width: 4px;
    height: 8px;
    border-radius: 2px;
    background: var(--cyan);
    animation: cue 1.6s var(--ease) infinite;
  }
  @keyframes cue {
    0% {
      opacity: 0;
      transform: translateY(-4px);
    }
    40% {
      opacity: 1;
    }
    80%,
    100% {
      opacity: 0;
      transform: translateY(10px);
    }
  }

  @media (min-width: 900px) {
    .hero-grid {
      grid-template-columns: 1.05fr 0.95fr;
    }
    .hero-copy {
      max-width: 34rem;
    }
  }
  /* Entrada del hero — CSS inmediato (no gated por JS/IntersectionObserver),
     así el contenido above-the-fold no retrasa el LCP. La imagen (elemento
     LCP) se anima solo con transform, nunca con opacity, para que quede
     "pintada" desde el primer frame. */
  @media (prefers-reduced-motion: no-preference) {
    .hero-in {
      opacity: 0;
      transform: translateY(22px);
      animation: hero-in 0.7s var(--ease) forwards;
    }
    .hero-copy .hero-in:nth-child(1) {
      animation-delay: 0.05s;
    }
    .hero-copy .hero-in:nth-child(2) {
      animation-delay: 0.13s;
    }
    .hero-copy .hero-in:nth-child(3) {
      animation-delay: 0.21s;
    }
    .hero-copy .hero-in:nth-child(4) {
      animation-delay: 0.29s;
    }
    .hero-copy .hero-in:nth-child(5) {
      animation-delay: 0.37s;
    }
    .hero-visual {
      animation: hero-visual-in 0.9s var(--ease) both;
    }
    @keyframes hero-in {
      to {
        opacity: 1;
        transform: none;
      }
    }
    @keyframes hero-visual-in {
      from {
        transform: translateY(18px) scale(0.97);
      }
      to {
        transform: none;
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .orb,
    .visual-ring,
    .float-pill,
    .scroll-cue span {
      animation: none !important;
    }
  }
</style>
