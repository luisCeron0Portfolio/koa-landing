<p id="waitlist-count" aria-live="polite"></p>

<script>
  import { formatWaitlistCount } from '../lib/domain/social-proof';

  const el = document.getElementById('waitlist-count');

  fetch('/api/waitlist-count')
    .then((r) => r.json())
    .then(({ count }: { count: number }) => {
      if (el) el.textContent = formatWaitlistCount(count);
    })
    .catch(() => {
      // Silencioso: sin contador es mejor que un número incorrecto o un
      // error visible al usuario (RF-006 no es crítico para el flujo).
    });
</script>

<style>
  #waitlist-count {
    text-align: center;
    opacity: 0.7;
    font-size: 0.9rem;
    margin: 0 0 1rem;
    min-height: 1.2em;
  }
</style>
