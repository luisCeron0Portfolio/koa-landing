---
import { hashToken, isTokenExpired } from '../lib/domain/token';
import { sql } from '../lib/adapters/neon';

export const prerender = false;

type ConfirmationOutcome = 'confirmed' | 'expired' | 'invalid';

const token = Astro.url.searchParams.get('token') ?? '';
let outcome: ConfirmationOutcome = 'invalid';

if (token) {
  // FA-02: token inválido/ya usado → 404 genérico, sin filtrar la causa. El
  // lookup es por hash — el token en claro nunca se compara directo en SQL.
  const tokenHash = hashToken(token);

  const rows = (await sql`
    SELECT id, status, confirmation_token_created_at
    FROM leads
    WHERE confirmation_token_hash = ${tokenHash}
    LIMIT 1
  `) as { id: string; status: string; confirmation_token_created_at: string | null }[];
  const lead = rows[0];

  if (lead && lead.status === 'confirmed') {
    // Ya confirmado antes (ej. doble click en el link) — mismo resultado
    // visual que una confirmación exitosa, sin volver a escribir.
    outcome = 'confirmed';
  } else if (
    lead &&
    lead.confirmation_token_created_at &&
    isTokenExpired(new Date(lead.confirmation_token_created_at))
  ) {
    // FA-01: token expirado → página con opción de reenviar.
    outcome = 'expired';
  } else if (lead) {
    await sql`UPDATE leads SET status = 'confirmed', confirmed_at = now() WHERE id = ${lead.id}`;
    outcome = 'confirmed';
  }
}

if (outcome === 'invalid') {
  Astro.response.status = 404;
}

const copy: Record<ConfirmationOutcome, { title: string; body: string }> = {
  confirmed: {
    title: '¡Listo! Tu lugar está confirmado.',
    body: 'Ya formás parte de la lista de espera de KOA Buds. Te avisamos apenas abra el lanzamiento.',
  },
  expired: {
    title: 'Este link expiró',
    body: 'Los links de confirmación duran 24 horas. Volvé a la landing para pedir uno nuevo.',
  },
  invalid: {
    title: 'Link inválido',
    body: 'Este link de confirmación no es válido o ya fue usado.',
  },
};
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>KOA Buds — Confirmación</title>
  </head>
  <body>
    <main>
      <h1>{copy[outcome].title}</h1>
      <p>{copy[outcome].body}</p>
      <a href="/">Volver a la landing</a>
    </main>
  </body>
</html>

<style>
  body {
    display: grid;
    place-items: center;
    min-height: 100svh;
    margin: 0;
    font-family: system-ui, sans-serif;
    background: #0b0b0f;
    color: #f5f5f7;
    padding: 1.5rem;
  }
  main {
    text-align: center;
    max-width: 32rem;
  }
  h1 {
    font-size: clamp(1.5rem, 5vw, 2.5rem);
    letter-spacing: -0.02em;
    margin: 0 0 0.75rem;
  }
  p {
    opacity: 0.8;
    margin: 0 0 1.5rem;
  }
  a {
    color: #f5f5f7;
  }
</style>
